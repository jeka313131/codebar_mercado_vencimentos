# Backend
PORT=3000
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-chave-publica
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Firebase Admin (JSON minificado do service account — Firebase Console → Contas de serviço)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Evolution API (opcional — sem isso o código OTP aparece no log do backend em dev)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# TLS: auto-desabilita verificação SSL quando a URL usa IP (VPS HostGator). Use false com domínio válido.
# EVOLUTION_TLS_INSECURE=true

# Alertas automáticos (node-cron no backend — desative na VPS se usar cron externo)
ENABLE_ALERT_CRON=true
# Segredo para POST /api/cron/send-alerts (produção na VPS)
CRON_SECRET=

# Frontend (build time — deixe vazio no Docker; use URL do Render na Vercel)
VITE_API_URL=

# Supabase (frontend/.env.local em dev)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica

# Firebase (frontend/.env.local em dev)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
